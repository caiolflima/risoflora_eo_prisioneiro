; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Risoflora_e_o_Bucaneiro"
run/main_scene="uid://cjhbv33fer3tl"
config/features=PackedStringArray("4.5", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

Dialogic="*res://addons/dialogic/Core/DialogicGameHandler.gd"
Dice="res://scene/dice.gd"
Global="*res://scripts/global.gd"
AudioManager="*res://audio manager/audio_manager.tscn"

[dialogic]

directories/dch_directory={
"Alicate": "res://characters/Alicate.dch",
"Boi": "res://characters/Boi.dch",
"Cabo": "res://characters/Cabo.dch",
"Galego": "res://characters/Galego.dch",
"Noiva": "res://characters/Noiva.dch",
"Player": "res://characters/Player.dch",
"Risoflora": "res://characters/Risoflora.dch",
"Soldado": "res://characters/Soldado.dch",
"Tenente": "res://characters/Tenente.dch",
"Tinhoso": "res://characters/Tinhoso.dch",
"Vela": "res://characters/Vela.dch",
"souza_leao": "res://characters/souza_leao.dch"
}
directories/dtl_directory={
"capitulo1": "res://timelines test/capitulo1.dtl",
"maintest": "res://timelines test/maintest.dtl",
"morte": "res://timelines test/morte.dtl",
"nome_jogador_teste": "res://timelines test/nome_jogador_teste.dtl"
}
layout/style_directory={
"": "res://resources/estilo2.tres",
"estilo1": "res://resources/estilo1.tres",
"estilo2": "res://resources/estilo2.tres"
}
layout/style_list=["res://resources/estilo1.tres", "res://resources/estilo2.tres"]
layout/default_style="res://resources/estilo2.tres"
text/letter_speed=0.01
text/initial_text_reveal_skippable=true
text/text_reveal_skip_delay=0.1
text/advance_delay=0.1
text/autoadvance_per_character_delay=0.1
text/autoadvance_ignored_characters_enabled=true
animations/join_default_length=0.5
animations/join_default_wait=true
animations/leave_default_length=0.5
animations/leave_default_wait=true
animations/cross_fade_default_length=0.5
choices/autofocus_first=true
choices/delay=0.2
choices/reveal_delay=0
choices/reveal_by_input=false
save/autosave_delay=60.0
save/encryption_on_exports_only=true
text/autopauses={}
audio/channel_defaults={
"": {
"audio_bus": "",
"fade_length": 0.0,
"loop": false,
"volume": -10.0
},
"music": {
"audio_bus": "",
"fade_length": 0.0,
"loop": true,
"volume": 0.0
}
}
variables={
"Nome_test": "",
"pronome1": "",
"pronome2": "",
"pronome3": "",
"pronome4": "",
"resultado": 0.0,
"resultado_teste": "",
"visivel": false
}
glossary/default_case_sensitive=true

[editor_plugins]

enabled=PackedStringArray("res://addons/dialogic/plugin.cfg")

