join souza_leao left
souza_leao: Qual seu nome?
leave souza_leao
[text_input text="Nome" var="Nome_test" placeholder="Nome" default="Nome"]
join Tinhoso center
Tinhoso: {Nome_test}, {Nome_test}!!!
souza_leao: Quais seus pronomes?
- Ele/Dele
	set {pronome1} = "ele"
	set {pronome2} = "dele"
	set {pronome3} = ""
	set {pronome4} = "o"
- Ela/Dela
	set {pronome1} = "ela"
	set {pronome2} = "dela"
	set {pronome3} = "a"
	set {pronome4} = "a"
- Ile/Dile
	set {pronome1} = "elu"
	set {pronome2} = "delu"
	set {pronome3} = "e"
	set {pronome4} = "e"
souza_leao: {pronome4} Senhor{pronome3} será bem tratad{pronome4} aqui!\
[wave amp=50.0 freq=5.0 connected=1]{pronome1} já disse tudo! Cuidem bem {pronome2} por aqui![/wave]
souza_leao: [wave amp=50.0 freq=5.0 connected=1]{Nome_test}, agora faz um teste ai pra gente![/wave]
leave Tinhoso
[signal arg="spawn_dices"]
[signal arg="ligar_teste"]
[wait time="3.0"]
[signal arg="coletar_resultado1"]
[signal arg="coletar_resultado2"]
souza_leao: O maior dos dados foi {resultado} e o seu resultado foi um {resultado_teste}!
[signal arg="limpar_resultado"]